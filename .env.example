# Copy to .env for local development with `npx netlify-cli dev`. NEVER commit .env.
# On Netlify these are set under Site configuration -> Environment variables.

# Mailchimp Marketing API key (Account -> Extras -> API keys). Ends with "-us21" style suffix.
MAILCHIMP_API_KEY=
# Audience ID (Audience -> Settings -> Audience name and defaults)
MAILCHIMP_AUDIENCE_ID=
# Data centre prefix, the part after the dash in the API key, e.g. us21
MAILCHIMP_SERVER_PREFIX=
